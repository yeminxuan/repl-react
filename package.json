{
  "name": "repl-react",
  "description": "Online React application",
  "version": "0.0.8-beta.2",
  "type": "module",
  "main": "dist/repl-react.js",
  "module": "dist/repl-react.js",
  "types": "dist/repl-react.d.ts",
  "exports": {
    ".": {
      "types": "./dist/repl-react.d.ts",
      "import": "./dist/repl-react.js"
    },
    "./codemirror-editor": {
      "types": "./dist/codemirror-editor.d.ts",
      "import": "./dist/codemirror-editor.js",
      "require": null
    },
    "./package.json": "./package.json",
    "./style.css": "./dist/index.css",
    "./dist/style.css": "./dist/index.css",
    "./codemirror-editor.css": "./dist/codemirror-editor.css"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "dev": "vite -c vite.preview.config.ts",
    "build": "tsc -b && vite build",
    "build-preview": "vite build -c vite.preview.config.ts",
    "lint": "biome lint",
    "format": "biome format --write ./src",
    "preview": "vite preview -c vite.preview.config.ts",
    "pub": "npm login & npm run build & npm publish",
    "release": "nr format && bumpp -r && nr pub",
    "build:watch": "tsc --watch"
  },
  "devDependencies": {
    "@biomejs/biome": "1.9.4",
    "@codemirror/autocomplete": "^6.18.3",
    "@codemirror/lang-javascript": "^6.2.2",
    "@codemirror/language": "^6.10.3",
    "@codemirror/state": "^6.4.1",
    "@iconify/react": "^5.1.0",
    "@lezer/highlight": "^1.2.1",
    "@swc/wasm-typescript-esm": "^1.13.5",
    "@swc/wasm-web": "^1.13.5",
    "@types/codemirror": "^5.60.15",
    "@types/node": "^22.9.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^5.0.2",
    "bumpp": "^9.9.1",
    "codemirror": "^6.0.1",
    "fflate": "^0.8.2",
    "globals": "^15.11.0",
    "typescript": "~5.6.2",
    "typescript-eslint": "^8.11.0",
    "vite": "^6.0.3",
    "vite-plugin-dts": "^4.3.0"
  },
  "peerDependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "packageManager": "pnpm@9.15.0",
  "files": [
    "dist"
  ],
  "typesVersions": {
    "*": {
      "*": [
        "./dist/*",
        "./*"
      ]
    }
  },
  "homepage": "https://github.com/zhangmo8/repl-react#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zhangmo8/repl-react.git"
  },
  "bugs": {
    "url": "https://github.com/zhangmo8/repl-react/issues"
  },
  "license": "MIT",
  "author": {
    "name": "Zhangmo8<wegi866@gmail.com>",
    "email": "wegi866@gmail.com",
    "url": "https://github.com/zhangmo8"
  }
}
